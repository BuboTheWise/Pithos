# Three (or more) single units clustered through a 5GBASE-T switch, network (D2).
# Render: d2 --layout=dagre d2-cluster-three-units-network.d2 d2-cluster-three-units-network.svg  (and .png)
direction: down
classes: {
  hot: {style: {fill: "#fee2e2"; stroke: "#d1242f"; stroke-width: 2}}
  cool: {style: {fill: "#dbeafe"; stroke: "#1f6feb"; stroke-width: 2}}
  warn: {style: {fill: "#fff7ed"; stroke: "#e07b00"; stroke-width: 2}}
  ok: {style: {fill: "#dcfce7"; stroke: "#1a7f37"; stroke-width: 2}}
  gray: {style: {fill: "#f3f4f6"; stroke: "#6b7280"}}
  note: {style: {fill: "#ffffff"; stroke: "#6b7280"; stroke-dash: 3; font-size: 14}}
}
title: "Three units clustered through a 5GBASE-T switch (USB 5GbE adapters)" {shape: text; style.font-size: 30}
ua: "Unit A (head)\nBC-250 + RTL8157 adapter\nllama-server :8081\nCLUSTER jack (5GbE) + LAN (onboard 1 GbE or Wi-Fi 7)" {style: {fill: "#eff6ff"; stroke: "#1f6feb"; font-size: 20}}
ub: "Unit B (worker)\nBC-250 + RTL8157 adapter\nggml-rpc-server :50052\nCLUSTER jack + LAN" {style: {fill: "#f0fdf4"; stroke: "#1a7f37"; font-size: 20}}
uc: "Unit C (worker)\nBC-250 + RTL8157 adapter\nggml-rpc-server :50052\nCLUSTER jack + LAN" {style: {fill: "#f0fdf4"; stroke: "#1a7f37"; font-size: 20}}
sw: "5GBASE-T switch, e.g. Ubiquiti USW-Flex-XG\n4 x 10GbE RJ45 (each negotiates 5G), fanless, 25 W max\nports 1-3: one Cat6 per unit CLUSTER jack; port 4: spare (4th unit)" {class: ok; style.font-size: 20}
lan: "LAN: onboard 1 GbE jack and/or Wi-Fi 7 adapter" {class: gray; style.font-size: 20}
cl: "Clients and Hermes: head :8081 /v1" {class: gray; style.font-size: 20}
ua -> sw: "5G" {style: {stroke: "#1a7f37"; stroke-width: 4}}
ub -> sw: "5G" {style: {stroke: "#1a7f37"; stroke-width: 4}}
uc -> sw: "5G" {style: {stroke: "#1a7f37"; stroke-width: 4}}
ua -> lan: "LAN" {style.stroke-dash: 4}
ub -> lan: "LAN" {style.stroke-dash: 4}
uc -> lan: "LAN" {style.stroke-dash: 4}
lan -> cl
note: "Two units default to a 1G direct Cat6 between the onboard ports; they need no switch and no 5GbE adapters.\nThe switch (3+ units) carries only cluster (RPC) traffic; client traffic stays on the 1 GbE LAN jacks or Wi-Fi 7.\nNever run cluster traffic over Wi-Fi. Unmanaged or managed is fine. 2.5G-only switches do NOT work at 5G." {class: note; style.font-size: 18}
