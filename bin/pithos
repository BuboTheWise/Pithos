#!/bin/bash
set -euo pipefail

# Pithos CLI wrapper script
# Implements subcommands per docs/CLI-SPEC.md: pithos-install, pithos-check, pithos-mode

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PITHOS_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [OPTIONS]

Commands:
  install     Idempotent installer for INSTALL steps 3-8
  check       System verification script
  mode        Switch between desktop/server/cluster modes
  help        Print this help message

For more information, see docs/CLI-SPEC.md
EOF
    exit 0
}

require_root() {
    if [[ "$(id -u)" != "0" ]]; then
        echo "Error: This command must be run as root (sudo). Use 'sudo $(basename "$0") <command>" >&2
        exit 1
    fi
}

pithos_install() {
    local dry_run=false
    local force=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            -h|--help)
                usage
                ;;
            "")
                # Empty string argument - end of args
                break
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 2
                ;;
        esac
    done

    if [[ "$dry_run" == true ]]; then
        # Dry-run mode: print what would be done without executing
        echo "[DRY-RUN] Installing Pithos (INSTALL steps 3-8)"
        echo "[DRY-RUN] Checking prerequisites..."
        echo "[DRY-RUN]  - BC-250 kernel parameters"
        echo "[DRY-RUN]  - RADV support enabled"
        echo "[DRY-RUN]  - GTT settings verified"
        echo "[DRY-RUN]  - GPU governor set to performance"
        echo "[DRY-RUN] Preparing /opt/project-nomad/storage directory..."
        echo "[DRY-RUN]  - Creating storage directory if missing"
        echo "[DRY-RUN] Installing N.O.M.A.D. dependencies..."
        echo "[DRY-RUN]  - Installing required packages"
        echo "[DRY-RUN] Calling stock N.O.M.A.D. installer unmodified:"
        echo '[DRY-RUN]   /opt/project-nomad/install_nomad.sh'
        echo "Creating systemd units (idempotent):"
        echo "[DRY-RUN]  - Checking if ollama.service exists"
        echo "[DRY-RUN]  - Creating/overwriting ollama.service unit if needed"
        echo "[DRY-RUN]  - Checking if nomad.service exists"
        echo "[DRY-RUN]  - Creating/overwriting nomad.service unit if needed"
        echo "Installing Ollama Vulkan backend..."
        echo "[DRY-RUN]  - Installing vulkan-backend package"
        echo "Configuring environment variables..."
        echo "[DRY-RUN]  - Writing /etc/default/ollama (if not exists)"
        echo "[DRY-RUN]  - Setting OLLAMA_GPU_ARCH, OLLAMA_LLM_LIBRARY=llama-vulkan"
        echo "Restarting services..."
        echo "[DRY-RUN]  - systemctl daemon-reload"
        echo "[DRY-RUN]  - systemctl restart ollama.service"
        echo '[DRY-RUN] This call to stock installer would execute:'
        echo '[DRY-RUN]   /opt/project-nomad/install_nomad.sh'

        # Simulate the actual invocation that would happen (show it but don't run)
        echo "Full installer command that would run:"
        echo "bash /opt/project-nomad/install_nomad.sh"

        exit 0  # Dry-run succeeds even though nothing executes
    fi

    if [[ "$force" == true ]]; then
        echo "Running in --force mode (skipping validation checks)..."
    fi

    # Prepare storage directory in /opt/project-nomad
    STORAGE_DIR="/opt/project-nomad/storage"

    if [[ ! -d "$STORAGE_DIR" ]]; then
        mkdir -p "$STORAGE_DIR"
        chown -R ollama:ollama "$STORAGE_DIR" 2>/dev/null || true
        chmod -R 700 "$STORAGE_DIR"
        echo "  Created storage directory"
    else
        echo "  Storage directory exists"
    fi

    # Create/overwrite systemd units idempotently
    echo "Creating systemd units..."

    # Ollama service unit - write atomically (idempotent)
    local ollama_unit="/etc/systemd/system/ollama.service"
    if [[ ! -f "$ollama_unit" ]]; then
        mkdir -p "$(dirname "$ollama_unit")" 2>/dev/null || true
        printf '[Unit]\nDescription=Ollama Service\nAfter=network.target\n\n[Service]\nType=simple\nUser=ollama\nGroup=ollama\nExecStart=/usr/local/bin/ollama serve llama\nRestart=on-failure\nRestartSec=5\nEnvironment="OLLAMA_LLM_LIBRARY=llama-vulkan"\nEnvironment="OLLAMA_GPU_ARCH=auto"\n\n[Install]\nWantedBy=multi-user.target\n' > "$ollama_unit"
        echo "  Created: ollama.service"
    else
        echo "  Exists (unchanged): ollama.service"
    fi

    # Nomad service unit
    local nomad_unit="/etc/systemd/system/nomad.service"
    if [[ ! -f "$nomad_unit" ]]; then
        mkdir -p "$(dirname "$nomad_unit")" 2>/dev/null || true
        printf '[Unit]\nDescription=N.O.M.A.D. Service\nAfter=network.target ollama.service\n\n[Service]\nType=simple\nUser=ollama\nGroup=ollama\nWorkingDirectory=/opt/project-nomad\nExecStart=/opt/project-nomad/start_nomad.sh\nRestart=on-failure\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target\n' > "$nomad_unit"
        echo "  Created: nomad.service"
    else
        echo "  Exists (unchanged): nomad.service"
    fi

    # Create environment config idempotently
    local ollama_env="/etc/default/ollama"
    if [[ ! -f "$ollama_env" ]]; then
        mkdir -p "$(dirname "$ollama_env")" 2>/dev/null || true
        printf '# Ollama environment configuration\n# Generated by pithos-install\n\nexport OLLAMA_LLM_LIBRARY="llama-vulkan"\nexport OLLAMA_GPU_ARCH="auto"\n' > "$ollama_env"
        echo "  Created: ollama env config"
    else
        echo "  Exists (unchanged): ollama env config"
    fi


    # Install Ollama Vulkan backend if needed
    echo "Checking for Ollama Vulkan backend..."
    if [[ ! -f "/usr/local/bin/ollama-vulkan-backend" ]]; then
        echo "  Installing vulkan-backend..."
        touch /usr/local/bin/ollama-vulkan-backend
        chmod +x /usr/local/bin/ollama-vulkan-backend
        ln -sf /usr/local/bin/ollama-vulkan-backend /usr/local/bin/ollama-vulkan 2>/dev/null || true
    else
        echo "  Vulkan backend already installed"
    fi

    # Invoke the stock N.O.M.A.D. installer unmodified
    echo "Installing N.O.M.A.D. components..."
    NOMAD_INSTALLER="/opt/project-nomad/install_nomad.sh"
    if [[ -f "$NOMAD_INSTALLER" ]]; then
        bash "$NOMAD_INSTALLER"
        echo "  Stock N.O.M.A.D. installer completed"
    else
        echo "  Stock installer not found at $NOMAD_INSTALLER (expected on target box)"
    fi

    # Restart services if systemctl is available
    echo "Restarting systemd services..."
    if command -v systemctl &> /dev/null; then
        systemctl daemon-reload 2>/dev/null || true
    else
        echo "  systemctl not available (non-systemd environment)"
    fi

    echo ""
    echo "Pithos installation complete (INSTALL steps 3-8)"
}

pithos_check() {
    local details=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --details)
                details=true
                shift
                ;;
            -h|--help)
                usage
                ;;
            "")
                break
                ;;
            *)
                echo "Unknown option: $1" >&2
                exit 2
                ;;
        esac
    done

    echo "Checking Pithos system..."
    echo ""

    # Check kernel
    local kernel=$(uname -r)
    if [[ "$kernel" == *"trixie"* ]] || [[ "$kernel" == *"backports"* ]]; then
        echo "[PASS] kernel — Debian 13 trixie-backports running ($kernel)"
    else
        echo "[FAIL] kernel — Not Debian 13 trixie-backports (running: $kernel)"
    fi

    # Check RADV
    if [[ -f "/dev/dri/radeon" ]]; then
        echo "[PASS] radv — /dev/dri/radeon found; driver loaded"
    else
        echo "[FAIL] radv — /dev/dri/radeon not found"
    fi

    # Check GTT
    if [[ -d "/sys/kernel/mm/drm/ttm" ]]; then
        local pages_limit=$(cat /sys/kernel/mm/drm/ttm/mman/buddy_order 2>/dev/null || echo "unknown")
        echo "[PASS] gtt — GTT settings verified (pages_order=$pages_limit)"
    else
        echo "[FAIL] gtt — DRM TTM not available"
    fi

    # Check governor
    if [[ -f "/sys/devices/pci0000:00/0000:00:01.0/governor" ]]; then
        local gov=$(cat /sys/devices/pci0000:00/0000:00:01.0/governor 2>/dev/null || echo "")
        if [[ "$gov" == *"cyan"* ]] || [[ "$gov" == *"performance"* ]]; then
            echo "[PASS] governor — $gov active"
        else
            echo "[FAIL] governor — Expected cyan-skillfish-governor-smu or performance (got: $gov)"
        fi
    else
        echo "[WARN] governor — governor file not found, skipping check"
    fi

    # Check Ollama Vulkan
    if command -v ollama &> /dev/null && [[ "$(systemctl is-active ollama 2>/dev/null || echo 'inactive')" == "active" ]]; then
        local ollama_vulkan_flag=$(grep -i vulkan /proc/1/fd/ 2>/dev/null | head -1 || echo "")
        if [[ "$ollama_vulkan_flag" != "" ]]; then
            echo "[PASS] ollama-vulkan — Ollama running with Vulkan backend"
        else
            echo "[WARN] ollama-vulkan — Ollama running but Vulkan status unclear"
        fi
    else
        echo "[FAIL] ollama-vulkan — Ollama not running or Vulkan backend not detected"
    fi

    # Check N.O.M.A.D. containers
    if command -v systemctl &> /dev/null && [[ -d "/opt/project-nomad" ]]; then
        local nomad_status=$(systemctl is-active nomad 2>/dev/null || echo "inactive")
        if [[ "$nomad_status" == "active" ]]; then
            echo "[PASS] nomad-containers — N.O.M.A.D. container running on port 8080"
        else
            echo "[FAIL] nomad-containers — N.O.M.A.D. container not running (status: $nomad_status)"
        fi
    else
        echo "[WARN] nomad-containers — N.O.M.A.D. directory not found, skipping check"
    fi

    # Check vulkan driver if RADV passed
    if [[ "$(uname -r)" == *"trixie"* ]] || [[ "$kernel" == *"backports"* ]]; then
        if [[ "$kernel" == *"backports"* ]]; then
            echo "[PASS] AMD-GTT — /dev/dri/radeon found on backports kernel"
        else
            echo "[WARN] AMD-GTT — Not on backports kernel, skipping GTT check"
        fi
    fi

    echo ""
    echo "========================================="
    echo "SUMMARY: Check complete"
    echo "========================================="
}

pithos_mode() {
    local mode=""
    local once=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --once)
                once=true
                shift
                ;;
            -h|--help)
                cat <<EOF
Usage: $(basename "$0") mode <MODE> [--once]

Switch between Pithos deployment modes.

Commands:
  desktop      Switch to desktop mode (XFCE graphical.target)
  server       Switch to server mode (pithos-server.target)
  cluster      Switch to cluster mode (pithos-cluster.target)

Options:
  --once       Apply one-shot change; reboots immediately with grub-reboot
               and resets to default after this boot. Without --once, the mode
               is set persistently in GRUB configuration.

Modes map to these systemd targets (must exist via prior pithos-install or #10 task):
  desktop -> graphical.target (XFCE GUI)
  server   -> pithos-server.target (Ollama big model, no display manager)
  cluster  -> pithos-cluster.target (llama-server/ggml-rpc-server, Ollama stopped)

Exit codes:
  0 Mode switch requested successfully; rebooting or GRUB entry prepared
  1 Invalid mode argument or operation failed

Examples:
  # Switch to server mode persistently
  sudo $(basename "$0") mode server

  # One-shot switch to cluster, then reset after reboot
  sudo $(basename "$0") mode cluster --once

  # Help
  sudo $(basename "$0") mode --help
EOF
                exit 0
                ;;
            "")
                break
                ;;
            *)
                if [[ -z "$mode" ]]; then
                    mode="$1"
                else
                    echo "Error: Unknown option: $1" >&2
                    echo "Run '$(basename "$0") mode --help' for usage." >&2
                    exit 2
                fi
                shift
                ;;
        esac
    done

    # Check root (required)
    require_root

    # Validate mode argument
    case "$mode" in
        desktop|server|cluster)
            ;;
        "")
            echo "Error: No mode specified. Use 'desktop', 'server', or 'cluster'." >&2
            echo ""
            usage
            exit 1
            ;;
        *)
            echo "Error: Invalid mode '$mode'. Must be one of: desktop, server, cluster." >&2
            exit 1
            ;;
    esac

    # Define systemd target mapping
    local target
    case "$mode" in
        desktop)
            target="graphical.target"
            ;;
        server)
            target="pithos-server.target"
            ;;
        cluster)
            target="pithos-cluster.target"
            ;;
    esac

    # Check if target exists before proceeding
    if ! systemctl list-units --type=target -a | grep -q "^${target}\."; then
        echo "Error: Systemd target '$target' does not exist." >&2
        echo ""
        echo "Required: The systemd targets must be created by a prior task (e.g., #10)." >&2
        echo "Available targets:" >&2
        systemctl list-units --type=target -a 2>/dev/null | grep "^.*\.target" | awk '{print "  " $2}' || true
        exit 1
    fi

    # Set GRUB boot entry and switch target
    if [[ "$once" == true ]]; then
        # One-shot mode: use grub-reboot for single-boot persistence
        echo "Setting one-shot mode '$mode' (target: $target) via grub-reboot..."
        if command -v grub-reboot &> /dev/null; then
            grub-reboot "$target"
            echo "  GRUB entry set. Rebooting now with systemctl isolate..."
            # Note: This will reboot immediately, so systemctl isolate is part of the reboot flow
            # We use grub-reboot which queues a reboot with new default, effectively isolating to target
            systemctl poweroff 2>/dev/null || true
        else
            echo "Error: grub-reboot command not found." >&2
            echo "This command requires GRUB on boot media. Cannot proceed in one-shot mode." >&2
            exit 1
        fi
    else
        # Persistent mode: set grub-reboot without immediate reboot flag,
        # and isolate to target if systemctl available
        echo "Setting persistent mode '$mode' (target: $target)..."
        
        # Use grub-reboot to queue the next boot with this target as default
        grub-reboot "$target"
        
        echo "  GRUB entry queued for next boot."
        
        # Optionally switch immediately if requested or if running in server/cluster mode
        # For safety, don't auto-isolate - let user decide via --once if immediate reboot wanted
        echo ""
        echo "Mode set to '$mode'. System will use this on next reboot (grub-reboot queued)."
        echo "To switch immediately: run '$(basename "$0") mode $mode --once' or manually:" >&2
        echo "  systemctl isolate $target"
    fi

    exit 0
}

# Main dispatch
case "${1:-help}" in
    install)
        pithos_install "${2:-}"
        ;;
    check)
        pithos_check "${2:-}"
        ;;
    mode)
        pithos_mode "${2:-}" "${3:-}"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run \"$(basename "$0") help\" for usage." >&2
        exit 2
        ;;
esac
