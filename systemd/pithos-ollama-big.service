[Unit]
Description=Pithos Big Model Ollama Service
Documentation=file:///usr/share/doc/pithos/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ollama serve
Environment=OLLAMA_LLM_LIBRARY=llama-vulkan
Environment=OLLAMA_GPU_ARCH=auto
WorkingDirectory=/opt/project-nomad/storage
Restart=on-failure
RestartSec=10
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=pithos-server.target
